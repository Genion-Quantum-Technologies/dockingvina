# DockingVina 环境变量配置
# 由 config.py 加载

# ============ PostgreSQL 数据库配置 ============
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=mydatabase
DB_POOL_MIN=1
DB_POOL_MAX=10

# ============ SeaweedFS 存储配置 ============
SEAWEED_API_TYPE=filer
SEAWEED_FILER_ENDPOINT=http://localhost:8888
SEAWEED_S3_ENDPOINT=http://localhost:8333
SEAWEED_BUCKET=astramolecula
SEAWEED_ACCESS_KEY=
SEAWEED_SECRET_KEY=

# ============ 文件路径配置 ============
RESOURCE_DIR=/tmp/docking_vina_app/resource
TEMP_DIR=/tmp/docking_vina_app
LOG_DIR=/tmp/docking_vina_app/logs

# ============ 预签名 URL 过期时间（秒）============
PRESIGNED_URL_EXPIRES=3600

# ============ 任务配置 ============
TASK_QUERY_INTERVAL=180
MAX_CONCURRENT_TASKS=3

# ============ Docking 配置 ============
DOCKING_NUM_CPU=8

# ============ BINANA 分析配置 ============
BINANA_ENABLED=true
BINANA_AUTO_ANALYZE=true
BINANA_TIMEOUT=300
BINANA_PATH=/home/songyou/projects/binana/python/run_binana.py
BINANA_SAVE_INTERMEDIATE=false
